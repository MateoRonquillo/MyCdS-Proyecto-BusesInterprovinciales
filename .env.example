# Copiar este archivo a .env y sustituir las credenciales de ejemplo.

# MySQL en Docker. Mantener estas claves si se reutiliza un volumen existente.
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=pasajes_db
MYSQL_USER=pasajes_app
MYSQL_PASSWORD=cambia_esta_clave_app
MYSQL_HOST_PORT=3307

# Puertos publicados por Docker Compose en el equipo local.
API_HOST_PORT=8000
WEB_HOST_PORT=8080

# Backend ejecutado directamente en el equipo.
# Ajustar usuario, clave, puerto y base cuando cambien las variables MYSQL_*.
# Codificar caracteres reservados de la clave al incorporarlos a esta URL.
# Docker Compose construye su propia conexión al servicio db en el puerto 3306.
DATABASE_URL=mysql+pymysql://pasajes_app:cambia_esta_clave_app@127.0.0.1:3307/pasajes_db

# Autenticación. Usar un secreto propio de al menos 32 caracteres.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Orígenes del frontend permitidos por el backend.
# Ajustar estos puertos si se cambian los del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Envío automático de boletos mediante Gmail SMTP.
# Dirección completa del remitente y contraseña de aplicación de Google.
# Completar ambas variables para activar el procesamiento de la cola.
# Con valores vacíos, los boletos permanecen pendientes de envío.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Frontend con Vite en desarrollo. Copiar estas variables a frontend/.env.
# Si se cambia API_HOST_PORT, actualizar también esta dirección.
# La imagen Docker del frontend usa /api en el mismo origen mediante Nginx.
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=false
VITE_USE_MOCKS_CLIENTE=false

# Opcional para la carga manual de demostración con el backend local.
# DEMO_PASSWORD=cambia_esta_clave_demo_de_12_caracteres_o_mas

# Opcionales para pruebas MySQL. Crear bases vacías y desechables antes de usarlas.
# Las pruebas eliminan sus tablas y la migración de prueba exige una base vacía.
# TEST_DATABASE_URL=mysql+pymysql://pasajes_app:cambia_esta_clave_app@127.0.0.1:3307/pasajes_integration_test
# MIGRATION_TEST_DATABASE_URL=mysql+pymysql://pasajes_app:cambia_esta_clave_app@127.0.0.1:3307/pasajes_migration_test
